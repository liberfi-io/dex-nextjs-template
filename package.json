{
  "name": "@liberfi/frontend",
  "version": "1.0.0",
  "description": "Liberfi web app",
  "author": "AI <ai@liberfi.io>",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=./apps/web",
    "lint": "turbo run lint --parallel && node scripts/verify-lint-baseline.mjs",
    "lint-fix": "turbo run lint-fix --parallel",
    "lint-staged": "lint-staged",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:gates && turbo run test",
    "test:gates": "node --test scripts/verify-workspace-gates.test.mjs",
    "tsconfig-paths": "tsx scripts/tsconfigPaths.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@manypkg/get-packages": "^2.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "30.0.0",
    "babel-jest": "30.2.0",
    "fs-extra": "^11.2.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^15.5.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "overrides": {
      "react-hook-form": "7.66.1"
    }
  }
}
