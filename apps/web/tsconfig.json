{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@liberfi.io/react-launchpad": [
        "../../../react-sdk/packages/react-launchpad/src"
      ],
      "@liberfi.io/react-redpacket": [
        "../../../react-sdk/packages/react-redpacket/src"
      ],
      "@liberfi.io/ui-launchpad": [
        "../../../react-sdk/packages/ui-launchpad/src"
      ],
      "@liberfi.io/ui-redpacket": [
        "../../../react-sdk/packages/ui-redpacket/src"
      ],
      "@liberfi.io/ui-tradingview": [
        "../../../react-sdk/packages/ui-tradingview/src"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
